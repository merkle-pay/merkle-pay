# Copy to .env.local and fill in. .env.local is gitignored.
#
# For production deploys, these live as Cloudflare Workers secrets:
#   wrangler secret put DATABASE_URL
#   wrangler secret put SOLANA_RPC_ENDPOINT

# Neon Postgres connection string (pooler host, sslmode=require).
DATABASE_URL=

# Solana mainnet RPC. Use a paid/dedicated provider — the public endpoint
# at api.mainnet-beta.solana.com rate-limits and often returns 403.
# Example: https://mainnet.helius-rpc.com/?api-key=<your-key>
SOLANA_RPC_ENDPOINT=
